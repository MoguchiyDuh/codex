# ==========================================
# Language-Specific Caches & Build Artifacts
# ==========================================

# Rust
rust/target/
**/target/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# C & C++ build output
c/bin/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.out

# ==========================================
# Credentials, Secrets & Env Files (CRITICAL)
# ==========================================

# Environment variables & local configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Private/Public Cryptographic Keys & SSH files
*.pem
*.key
*.pub
id_rsa
id_ecdsa
id_ed25519
*.pfx
*.p12

# Cloud credentials, API keys & configuration tokens
*credential*
*credentials*
*credential*.json
*credentials*.json
secrets.json
*secret*.json
*key*.json
.npmrc
.pypirc
.piprc
.netrc

# Password databases
*.passwd
*.password
passwd
passwords.txt

# ==========================================
# Generic Caches & System Files
# ==========================================

# macOS system files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon_
._*

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.swp
*~
